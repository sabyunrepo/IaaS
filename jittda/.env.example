# ============================================
# Jittda v5.0 — Environment Variables
# Copy to .env and fill in actual values
# ============================================

# --- Database ---
# docker-compose에서 자동 구성 (DATABASE_URL은 compose가 생성)
POSTGRES_DB=jittda
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- LLM (Kimi/Moonshot) ---
LLM_API_KEY=your_moonshot_api_key
LLM_BASE_URL=https://api.moonshot.cn/v1

# --- Embeddings (OpenAI) ---
# 미설정 시 LLM_API_KEY로 fallback (단, OpenAI 엔드포인트에 Moonshot 키 사용 불가)
EMBEDDING_API_KEY=your_openai_api_key
EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- GitHub (코드 분석용) ---
GITHUB_TOKEN=your_github_pat

# --- Langfuse (Prompt Management + Tracing) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key

# --- BrightData (LinkedIn Scraping, Optional) ---
BRIGHTDATA_API_KEY=your_brightdata_key
BRIGHTDATA_SCRAPING_BROWSER_URL=

# --- Auth ---
# JWT_SECRET: 프로덕션 필수 (32자 이상). 미설정 시 랜덤 생성 (재시작마다 세션 무효화)
JWT_SECRET=your_jwt_secret_min_32_chars
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
ALLOWED_ORIGINS=http://localhost:3001,https://dev.jittda.com
FRONTEND_URL=http://localhost:3001

# --- Temporal ---
TEMPORAL_HOST=temporal:7233

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# --- Frontend (Build-Time) ---
VITE_API_BASE=https://dev.jittda.com

# --- Resilience (Optional) ---
# CB_FAILURE_THRESHOLD=5        # Circuit Breaker 실패 임계치
# CB_RECOVERY_TIMEOUT=60        # Open → Half-Open 대기(초)
# CB_HALF_OPEN_MAX_CALLS=2      # Half-Open 테스트 호출 수

# --- Cache TTL (Optional, seconds) ---
# CACHE_TTL_GITHUB_META=3600    # GitHub 메타데이터 (1시간)
# CACHE_TTL_GITHUB_COMMITS=1800 # GitHub 커밋 (30분)
# CACHE_TTL_EMBEDDINGS=86400    # 임베딩 (24시간)
